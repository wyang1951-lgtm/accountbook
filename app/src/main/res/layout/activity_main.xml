<?xml version="1.0" encoding="utf-8"?>
<!--
    存款利息计算器 —— 界面布局
    根布局使用 ConstraintLayout（课件 3.3.7），里面嵌套 ScrollView + LinearLayout（课件 3.3.1）
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ===== 标题 ===== -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="@string/title"
                android:textColor="?attr/colorPrimary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- ===== 本金 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_principal"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_principal"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textSize="16sp" />

            <!-- ===== 年利率 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_rate"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/hint_rate"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textSize="16sp" />

            <!-- ===== 存期 ===== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_years"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etYears"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="@string/hint_years"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:textSize="16sp" />

            <!-- ===== 计算按钮 ===== -->
            <Button
                android:id="@+id/btnCalc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_calc"
                android:textSize="16sp" />

            <!-- ===== 结果显示 ===== -->
            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_result"
                android:lineSpacingExtra="6dp"
                android:padding="16dp"
                android:text="@string/empty_result"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
